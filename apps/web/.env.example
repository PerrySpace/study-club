# ============================================================================
# apps/web 环境变量模板（构建期静态求值，用于死代码消除）
#
#   本地开发：cp apps/web/.env.example apps/web/.env.local
#   容器构建：由 deploy/web/docker-compose.yml 的 build.args 传入
#
# 纪律：主流程「零密钥可运行」——以下全部留空时，前端走随包内容，
#       邀请码身份自动退回「先不注册（纯本地）」路径，功能完整。
# ============================================================================

# 云端后台接口地址（可为空；为空则 api = null，前端自动走本地/静态内容）
VITE_API_BASE_URL=

# 远端静态内容根地址（Cloudflare Pages / 对象存储等，可为空）
VITE_CDN_BASE=

# 能力开关（与 packages/core/flags 的 FeatureFlags 对应，仅这些可在此覆盖）
VITE_ENABLE_INVITE_AUTH=true
VITE_ENABLE_CONTENT_API=false
VITE_ENABLE_REMOTE_CONTENT=false
VITE_ENABLE_STATS=false

# ⛔ 以下四项需企业主体，必须保持 false（掩藏：不打包 + 不可达 + 不可调）
VITE_ENABLE_ACCOUNT_AUTH=false
VITE_ENABLE_PAYMENT=false
VITE_ENABLE_MINIPROGRAM=false
VITE_ENABLE_NATIVE_APP=false
