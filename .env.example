# ============================================================================
# study-club 环境变量模板
#
# 使用方式：复制为 .env（绝不提交真实密钥）：
#   cp .env.example .env
#
# 纪律：
#   1. 仓库内只提交本文件；.env / *.key / *.pem 已在 .gitignore 中忽略。
#   2. 主流程必须「零密钥可运行」：不填任何密钥时，前端走本地内容、后端只读内容包。
#   3. 端到端加密密钥由用户口令在客户端派生，服务端没有任何解密密钥——
#      因此不存在「数据加密密钥」这类服务端变量。若有人要求新增，说明方案被改坏了。
#   4. ⚠️ **值里含 `$` 时必须用单引号包住**：Docker Compose 用 dotenv 解析本文件，
#      未加引号会把 `$xxx` 当变量引用替换成空串（Argon2 口令哈希、base64 密钥最常中招）。
#      单引号值不做插值。详见下方 ADMIN_PASSWORD_HASH 处的说明。
# ============================================================================

# ---------------------------------------------------------------------------
# 通用
# ---------------------------------------------------------------------------
# 运行环境：development / production
APP_ENV=development
# 站点唯一入口（学科走 URL 路径 /hanzi /english /math，不开子域）
PUBLIC_SITE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# 端口（host 网络下各服务直接占用宿主端口；改这里即可整体迁移）
# ---------------------------------------------------------------------------
# Web（nginx）监听端口 —— 浏览器访问入口
WEB_PORT=8080
# 管理后台（apps/admin，nginx）监听端口 —— 内部工具，勿暴露公网
ADMIN_PORT=8081

# ---------------------------------------------------------------------------
# 数据库（MongoDB）—— 容器用 host 网络直连宿主/容器网络中的 MongoDB
#   容器 network_mode: host 时用 localhost；
#   Docker Desktop（macOS/Windows）若未启用 host 网络，改用 host.docker.internal
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/study_club
MONGODB_DB=study_club
# 本地起 MongoDB 容器时使用（deploy/mongo/.env）
MONGO_PORT=27017
MONGO_CACHE_GB=0.5
# MongoDB 监听地址。本机开发用 0.0.0.0（容器与同网段手机都能连）；
# ⚠️ 部署到共享局域网 / 公网机器必须改成 127.0.0.1 —— 数据库没有鉴权，
#    绑 0.0.0.0 等于把数据敞开；api 与 web 同为 host 网络，走 localhost 不受影响。
MONGO_BIND_IP=0.0.0.0
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# 后端（apps/api）
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# 统一的接口前缀（破坏性变更升 /api/v2）
API_PREFIX=/api/v1
# 会话签名密钥：部署时必须替换（openssl rand -hex 32）
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
# 邀请码签发私钥（Ed25519，仅后端或离线签发工具持有；公钥随开源代码公开）
INVITE_SIGNING_PRIVATE_KEY=
INVITE_SIGNING_PUBLIC_KEY=
# 单管理员后台口令哈希（Argon2id）。生成方式见 scripts/api/hash-password.sh
# ⚠️ 留空时 /admin/login 会返回 FEATURE_DISABLED，管理后台整体不可用。
#
# ⚠️⚠️ 必须用【单引号】包住哈希。Argon2 哈希形如
#     $argon2id$v=19$m=65536,t=3,p=2$<salt>$<digest>
#     含大量 `$`；而 Docker Compose 用 dotenv 解析本文件，**不加引号会把 `$m`、`$xxxx`
#     当成变量引用替换成空串**，哈希被悄悄改坏 → 表现为「口令明明对，却一直
#     返回 40301 管理员口令不正确」。dotenv 对单引号值不做插值，所以必须这样写：
#     ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$...$...'
ADMIN_PASSWORD_HASH=
# 邀请码是否必填（注册准入开关）。
#   false = 免码开放（开源克隆后即可注册体验；默认值）
#   true  = 服务端**强制**校验邀请码，未填直接拒绝注册
# 注意：这是服务端的强制开关，前端 `VITE_ENABLE_INVITE_REQUIRED` 是它的构建期侧；
#       运行期也可由「配置中心」（app_settings 集合）覆盖，此处仅作默认值。
REQUIRE_INVITE=false
# CORS 允许来源（逗号分隔）
#   ⚠️ 线上走「同源反代」后，浏览器不再发跨源请求，所以这里**不需要**写线上域名。
#      保留 localhost 各项是给「本机 vite dev server 直连后端」用的。
#   若要额外放行（例如直接用 http://域名:8000 调接口），把来源追加在后面。
#   :8080 学生端/家长端 · :5173 主站 dev server
#   :8081 管理后台（apps/admin） · :5174 管理后台 dev server
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:8081,http://localhost:5174

# ---------------------------------------------------------------------------
# 素材存储（apps/api）—— 内容全部由后台管理后，图片/音频/笔顺数据由服务端托管
#   文件落 ASSET_DIR（磁盘/命名卷），元数据落 MongoDB 的 assets 集合。
#   内容文档只存 `*_ref`（素材 id），出参时展开为 `*_url` —— 换配图不碰内容文档。
# ---------------------------------------------------------------------------
# 素材落盘目录。容器内固定为 /app/data/assets（deploy/api 已挂命名卷）；
# 宿主机直接跑 uvicorn 时用相对路径即可（相对进程 CWD）。
ASSET_DIR=./data/assets
# 素材出参的基址：**留空最稳**，此时出参是相对路径 `/api/v1/assets/<id>`，
# 前端按 API 源拼接 —— 换局域网 IP 不需要重建任何素材链接。
# 只有走 CDN 时才填绝对地址（如 https://cdn.example.com）。
ASSET_BASE_URL=
# 单文件体积上限（字节）。默认 10MB：一张字卡插画/一段朗读音频足够，
# 又不至于把服务端变成任意文件托管。
ASSET_MAX_BYTES=10485760
# 允许上传的 MIME 白名单（逗号分隔，支持 `image/*` 形式）
ASSET_ALLOWED_MIMES=image/svg+xml,image/png,image/jpeg,image/webp,image/gif,audio/mpeg,audio/mp4,audio/wav,audio/ogg,audio/webm,application/json

# ---------------------------------------------------------------------------
# 前端（apps/web）—— 构建期静态求值，用于死代码消除
# ---------------------------------------------------------------------------
# 接口基址。**容器部署用相对路径**：由 deploy/web 的 nginx 反代 /api/ → 127.0.0.1:8000。
# 必须是相对路径的原因：线上页面多在 HTTPS 域名下，若填 http://<ip>:8000 会命中
# 浏览器的**混合内容**拦截（请求根本发不出去，CORS 配得再对也没用），
# 且跨源白名单要跟着访问地址变。相对路径 + 同源反代一次解决，且同一份产物
# 在局域网 IP / 域名 / localhost 下都能用。
# ⚠️ 本机跑 vite dev server（:5173）时才需要绝对地址，那写在 apps/web/.env.local。
VITE_API_BASE_URL=/api/v1
# 静态 CDN（可选）：留空即由 web 容器同源托管
VITE_CDN_BASE=
VITE_ENABLE_INVITE_AUTH=true
# 是否强制凭码注册；false = 免码开放（直接可用）
VITE_ENABLE_INVITE_REQUIRED=true
# 邀请码离线签名校验（Ed25519 纯前端）
VITE_ENABLE_INVITE_OFFLINE_VERIFY=true
# 云端家庭档案与跨设备同步（默认关，用户显式开启）
VITE_ENABLE_CLOUD_PROFILE=false
# 端到端加密同步（默认开）
VITE_ENABLE_E2E_ENCRYPTION=true
VITE_ENABLE_CONTENT_API=true
VITE_ENABLE_REMOTE_CONTENT=true
VITE_ENABLE_STATS=true
# 云端语音评测（可选付费；无 Key 时整块隐藏，绝不显示假分数）
VITE_ENABLE_CLOUD_ASSESSMENT=false
# ⛔ 以下四项需企业主体，保持 false（掩藏：不打包 + 不可达 + 不可调）
VITE_ENABLE_ACCOUNT_AUTH=false
VITE_ENABLE_PAYMENT=false
VITE_ENABLE_MINIPROGRAM=false
VITE_ENABLE_NATIVE_APP=false
# 可选付费语音评测的服务端 Key：不配置即整块功能隐藏
ASSESSMENT_API_KEY=

# ---------------------------------------------------------------------------
# ⛔ 掩藏能力的变量（不启用，仅备查，当前不配置、不引用）
# ---------------------------------------------------------------------------
# SMS_PROVIDER_KEY=
# WECHAT_MP_APPID=
# WECHAT_OPEN_APPID=
# UNIONID_SALT=
# REDIS_URL=
