{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study-club/schema/unit.schema.json",
  "title": "自编单元",
  "description": "按主题 / 难度 / 字形规律组织，不复制任何出版物的单元顺序与课文标题。",
  "type": "object",
  "required": [
    "_id", "unit_code", "title", "theme", "grade", "grade_num", "semester",
    "organize_by", "character_ids", "focus", "unit_type", "order", "status"
  ],
  "additionalProperties": false,
  "properties": {
    "_id": { "type": "string" },
    "unit_code": { "type": "string", "pattern": "^u-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "minLength": 1 },
    "grade": { "type": "string", "minLength": 1 },
    "grade_num": { "type": "integer", "minimum": 1, "maximum": 6 },
    "semester": { "enum": ["上", "下"] },
    "organize_by": { "enum": ["theme", "difficulty", "radical", "custom"] },
    "character_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "focus": { "type": "string", "minLength": 1 },
    "unit_type": { "enum": ["识字", "古诗", "拓展"] },
    "order": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "pending_review", "published", "offline", "deleted"] }
  }
}
