      "_id": "rd_g1_01",
      "title": "数一数",
      "type": "sentence",
      "level": "grade1",
      "grade": 1,
      "difficulty": 1,
      "order": 1,
      "theme": "数字",
      "sentences": [
        {
          "text": "一二三，四五六，七八九十。",
          "pinyin": "yī èr sān, sì wǔ liù, qī bā jiǔ shí.",
          "meaning": "从一数到十。"
        },
        {
          "text": "天上一个日，水里一个月。",
          "pinyin": "tiān shàng yī gè rì, shuǐ lǐ yī gè yuè.",
          "meaning": "天上有一个太阳，水里有一个月亮。"
        },
        {
          "text": "小手数一数：一二三四五。",
          "pinyin": "xiǎo shǒu shǔ yī shǔ: yī èr sān sì wǔ.",
          "meaning": "用小手指着数一数。"
        }
      ],
      "text": "一二三，四五六，七八九十。天上一个日，水里一个月。小手数一数：一二三四五。",
