    {
      "_id": "rd_g1_03",
      "title": "天地山水",
      "type": "passage",
      "level": "grade1",
      "grade": 1,
      "difficulty": 2,
      "order": 3,
      "theme": "自然",
      "sentences": [
        {
          "text": "天上白云，地上青草。",
          "pinyin": "tiān shàng bái yún, dì shàng qīng cǎo.",
          "meaning": "天上有白云，地上有青草。"
        },
        {
          "text": "山上有石，石下有水。",
          "pinyin": "shān shàng yǒu shí, shí xià yǒu shuǐ.",
          "meaning": "山上有石头，石头下面有水。"
        },
        {
          "text": "水里有鱼，天上有鸟。",
          "pinyin": "shuǐ lǐ yǒu yú, tiān shàng yǒu niǎo.",
          "meaning": "水里有鱼，天上有鸟。"
        },
        {
          "text": "风来云去，雨下花开。",
          "pinyin": "fēng lái yún qù, yǔ xià huā kāi.",
          "meaning": "风来了云走了，雨落下花儿开了。"
        }
      ],
      "text": "天上白云，地上青草。山上有石，石下有水。水里有鱼，天上有鸟。风来云去，雨下花开。",
