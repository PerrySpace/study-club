      "_id": "rd_g1_04",
      "title": "我上学看书",
      "type": "passage",
      "level": "grade1",
      "grade": 1,
      "difficulty": 2,
      "order": 4,
      "theme": "学习",
      "sentences": [
        {
          "text": "我上学，看书。",
          "pinyin": "wǒ shàng xué, kàn shū.",
          "meaning": "我去上学，看故事书。"
        },
        {
          "text": "书上有字，我看。",
          "pinyin": "shū shàng yǒu zì, wǒ kàn.",
          "meaning": "书上有字，我来看。"
        },
        {
          "text": "小手上，书一本。",
          "pinyin": "xiǎo shǒu shàng, shū yī běn.",
          "meaning": "小手上放着一本书。"
        },
        {
          "text": "好学生，天天看书。",
