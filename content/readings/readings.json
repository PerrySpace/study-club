    {
      "_id": "rd_g1_02",
      "title": "我的身体",
      "type": "sentence",
      "level": "grade1",
      "grade": 1,
      "difficulty": 1,
      "order": 2,
      "theme": "人与身体",
      "sentences": [
        {
          "text": "人有口，人有目。",
          "pinyin": "rén yǒu kǒu, rén yǒu mù.",
          "meaning": "人有嘴巴，人有眼睛。"
        },
        {
          "text": "目看天，口读书。",
          "pinyin": "mù kàn tiān, kǒu dú shū.",
          "meaning": "眼睛看天空，嘴巴读课文。"
        },
        {
          "text": "人有耳，耳听风。",
          "pinyin": "rén yǒu ěr, ěr tīng fēng.",
          "meaning": "人有耳朵，耳朵听风声。"
        },
        {
          "text": "人有手有足，上山下地。",
          "pinyin": "rén yǒu shǒu yǒu zú, shàng shān xià dì.",
          "meaning": "人有手有脚，能上山能下地。"
        }
