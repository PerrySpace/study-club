# ============================================================================
# deploy/mongo/.env.example —— 该服务的环境变量（复制到仓库根 .env 统一管理）
# ============================================================================

# MongoDB 端口（host 网络下监听宿主端口）
MONGO_PORT=27017

# 数据库名（与 MONGODB_DB 保持一致）
MONGODB_DB=study_club

# WiredTiger 缓存上限（GB）；1C1G 小机器建议 0.5
MONGO_CACHE_GB=0.5

# 鉴权：本地开发可留空；对外暴露时必须填写
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
