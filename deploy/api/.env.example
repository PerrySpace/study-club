# ============================================================================
# deploy/api 的 compose 变量（用于 docker-compose.yml 的 ${VAR} 插值）
#
# 使用方式：把本文件复制为 deploy/api/.env（不要提交真实密钥）。
#   cp deploy/api/.env.example deploy/api/.env
#
# 注意：**容器内的应用环境变量来自仓库根的 .env**（compose 里的 env_file: ../../.env），
#       本文件只影响 compose 自身的插值（如端口）。两者变量名可重叠。
# ============================================================================

# api 监听端口（host 网络下即宿主端口）
API_PORT=8000
# 统一接口前缀（破坏性变更升 /api/v2）
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# 以下为「应用运行时」需要、但应写在仓库根 .env 中的变量（此处仅备查，供插值/对齐）
# ---------------------------------------------------------------------------
# MONGODB_URI=mongodb://localhost:27017/study_club
# MONGODB_DB=study_club
# JWT_SECRET=dev-only-change-me
# ACCESS_TOKEN_TTL_MIN=30
# REFRESH_TOKEN_TTL_DAYS=30
# INVITE_SIGNING_PRIVATE_KEY=
# INVITE_SIGNING_PUBLIC_KEY=
# ADMIN_PASSWORD_HASH=
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173
